{
  "name": "quran-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "mushaf:fetch": "tsx scripts/fetch-mushaf.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed-db.ts",
    "db:recompute": "tsx --env-file-if-exists=.env scripts/recompute.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@node-rs/argon2": "^2.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "drizzle-orm": "^0.45.4",
    "next": "^15.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
